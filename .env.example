# mef-mcp needs no credentials: every MEF source it reaches is public.
# Both variables are optional.

# Where the response cache and the local database live.
# Default: %LOCALAPPDATA%\mef-mcp (Windows), ~/Library/Caches/mef-mcp (macOS),
# $XDG_CACHE_HOME/mef-mcp or ~/.cache/mef-mcp (Linux).
# MEF_HOME=/path/to/mef-home

# SQLite database used by `mef sync`, `mef sql` and `mef tablas`.
# Default: $MEF_HOME/mef.db
# MEF_DB=/path/to/mef.db

# Honoured by the CLI to disable ANSI colour.
# NO_COLOR=1
